# ============================================================
# AI 记忆卡 · 服务端环境变量模板
# 复制为 .env 后填写真实值；.env 永不提交（见 .gitignore）
# 生成密钥：python -c "import secrets; print(secrets.token_urlsafe(64))"
# ============================================================

# --- 应用 ---
APP_ENV=dev                      # dev=开 /docs 与详细报错；prod=关闭
APP_HOST=0.0.0.0                 # 手机联调必须 0.0.0.0，不能 127.0.0.1
APP_PORT=8000

# --- 鉴权（本期骨架阶段暂未接入，占位） ---
JWT_SECRET=                      # Access token 签名密钥（必填敏感项）
JWT_REFRESH_SECRET=              # Refresh token 签名密钥（与上者必须不同）
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- 数据库 ---
# 开发期（本机无 PostgreSQL）：默认 SQLite 兜底
# 生产 / 联调：换成托管 PostgreSQL 连接串（必填敏感项）
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# --- 对象存储（本期骨架阶段暂未接入，占位） ---
STORAGE_BACKEND=local            # s3=对象存储（生产默认）；local=本机磁盘（仅开发）
STORAGE_LOCAL_ROOT=./data/audio
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- 上传限制 ---
MAX_UPLOAD_MB=50

# --- 其它 ---
CORS_ORIGINS=http://localhost
LOG_LEVEL=INFO
ARGON2_TIME_COST=3

# --- AI（本期不做，占位，密钥只存服务端） ---
ASR_PROVIDER=
ASR_API_KEY=
LLM_API_KEY=
